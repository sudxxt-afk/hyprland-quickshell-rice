#!/usr/bin/env bash
#
# fedora-slim — облегчение Fedora под Hyprland + end-4 ii.
#
# Запускать ПОСЛЕ перезагрузки в Fedora 45: если удалить пакеты между
# `dnf system-upgrade download` и `reboot`, скачанная транзакция сломается.
#
#   fedora-slim            # всё по порядку, dnf сам спросит y/N перед удалением
#   fedora-slim --dry-run  # только показать, что будет удалено/выключено
#
set -euo pipefail

DRY=0
[[ "${1:-}" == "--dry-run" ]] && DRY=1

if [[ $EUID -ne 0 ]]; then
    exec sudo "$0" "$@"
fi

log() { printf '\033[1;35m::\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m!!\033[0m %s\n' "$*" >&2; exit 1; }
run() { if (( DRY )); then echo "   [dry-run] $*"; else "$@"; fi; }

# ─────────────────────────────────────────────────────────────────────────────
# 0. Защита от запуска посреди апгрейда
# ─────────────────────────────────────────────────────────────────────────────
if pgrep -x dnf >/dev/null || pgrep -x dnf5 >/dev/null; then die "Сейчас работает dnf — дождись окончания"; fi
[[ -e /system-update ]] && die "Запланирован offline-апгрейд — сначала перезагрузись в него"
REL="$(rpm -E %fedora)"
(( REL >= 45 )) || die "Система ещё Fedora $REL. Сначала закончи апгрейд до 45 и перезагрузись"

# ─────────────────────────────────────────────────────────────────────────────
# 1. Пакеты
# ─────────────────────────────────────────────────────────────────────────────
# Части KDE, которые использует end-4 ii — их не трогаем:
#   plasma-integration + kdeglobals  → тема Qt (QT_QPA_PLATFORMTHEME=kde),
#       тянет за собой plasma-breeze(-qt5) и plasma-integration-qt5
#   plasma-breeze-qt6/-common, darkly, kvantum, qt6ct → стили Qt
#   breeze-icon-theme, breeze-cursor-theme → фолбэк иконок/курсора
#   kdialog → выбор обоев в ii
KEEP=(
    plasma-integration plasma-integration-qt5 plasma-breeze plasma-breeze-qt5 plasma-breeze-qt6
    plasma-breeze-common darkly
    kvantum kvantum-data qt6ct breeze-icon-theme breeze-cursor-theme kdialog
)

# Plasma-сессия и KDE-приложения (дисплей-менеджер у тебя gdm, не sddm)
KDE=(
    plasma-desktop plasma-workspace plasma-workspace-common plasma-workspace-libs
    plasma-systemsettings plasma-systemmonitor plasma-nm plasma-keyboard
    plasma-lookandfeel-fedora plasma-union plasma5support plasma-activities
    plasma-activities-stats bluedevil
    kwin kwin-common kwin-libs kscreenlocker kglobalacceld kactivitymanagerd
    kmenuedit kwrited powerdevil polkit-kde kde-settings-plasma
    sddm sddm-breeze sddm-wayland-plasma kde-settings-sddm
    dolphin dolphin-libs baloo-widgets kio-extras kio-fuse kdegraphics-mobipocket
    kaccounts-integration-qt6 signon signon-plugin-oauth2 signon-qt6
    kdesu kde-cli-tools xdg-desktop-portal-kde ocean-sound-theme
)

# Гостевые агенты виртуалок: это железо, systemd-detect-virt = none
VM_GUEST=(
    open-vm-tools open-vm-tools-desktop virtualbox-guest-additions
    qemu-guest-agent spice-vdagent spice-webdavd hyperv-daemons
)

# Прочее: snapd без единого приложения (~1.9 ГБ), abrt, rsyslog (дублирует journald)
MISC=(snapd abrt abrt-libs abrt-cli rsyslog)

installed() { for p in "$@"; do rpm -q "$p" &>/dev/null && echo "$p"; done; }
mapfile -t REMOVE < <(installed "${KDE[@]}" "${VM_GUEST[@]}" "${MISC[@]}")
mapfile -t KEEP_INST < <(installed "${KEEP[@]}")

log "Помечаю как установленные вручную (autoremove их не тронет): ${KEEP_INST[*]}"
run dnf mark user "${KEEP_INST[@]}"

if (( ${#REMOVE[@]} )); then
    log "Удаляю ${#REMOVE[@]} пакетов (dnf покажет итоговый список и спросит подтверждение)"
    if (( DRY )); then
        dnf remove --assumeno "${REMOVE[@]}" || true
    else
        dnf remove "${REMOVE[@]}"
    fi
fi

log "Удаляю осиротевшие зависимости (kf6-*, kf5-* и т.п.)"
if (( DRY )); then dnf autoremove --assumeno || true; else dnf autoremove; fi

[[ -d /var/lib/snapd ]] && ! rpm -q snapd &>/dev/null && run rm -rf /var/lib/snapd /snap

# ─────────────────────────────────────────────────────────────────────────────
# 2. Сервисы, которые на этом ноутбуке не нужны
# ─────────────────────────────────────────────────────────────────────────────
# livesys*      — остатки live-образа
# wait-online   — тормозит загрузку, ничего у тебя от него не зависит
# dnf-makecache — периодически ест RAM/CPU в фоне; кэш обновится при dnf upgrade
# iscsi*, mdmonitor, raid-check — нет iSCSI и RAID (/proc/mdstat пуст)
# sssd          — профиль authselect "local", домен не подключён
# systemd-homed — home areas нет
# mcelog        — логирование MCE, для ноутбука бесполезно
# cups.service  — остаётся cups.socket: принтер поднимется по первому запросу
UNITS=(
    livesys.service livesys-late.service
    NetworkManager-wait-online.service dnf-makecache.timer
    iscsi-onboot.service iscsi-starter.service iscsid.socket iscsiuio.socket
    mdmonitor.service raid-check.timer
    sssd.service systemd-homed.service systemd-homed-activate.service
    mcelog.service cups.service
)
for u in "${UNITS[@]}"; do
    if systemctl list-unit-files "$u" --no-legend 2>/dev/null | grep -q .; then
        log "Отключаю $u"
        run systemctl disable --now "$u" || true
    fi
done

# ─────────────────────────────────────────────────────────────────────────────
# 3. Тюнинг
# ─────────────────────────────────────────────────────────────────────────────
# zram уже есть (zstd, 7.4 ГБ). Для zram своп дешёвый, поэтому высокий swappiness
# выгоднее: в RAM остаётся больше места под кэш. page-cluster=0 — zram не нужен readahead.
log "sysctl под zram → /etc/sysctl.d/99-zram.conf"
if (( ! DRY )); then
    cat > /etc/sysctl.d/99-zram.conf <<'EOF'
vm.swappiness = 180
vm.page-cluster = 0
vm.watermark_boost_factor = 0
vm.watermark_scale_factor = 125
EOF
    sysctl -q --system
fi

log "Лимит журнала 200 МБ (сейчас ~1 ГБ)"
if (( ! DRY )); then
    mkdir -p /etc/systemd/journald.conf.d
    printf '[Journal]\nSystemMaxUse=200M\n' > /etc/systemd/journald.conf.d/size.conf
    systemctl restart systemd-journald
    journalctl --vacuum-size=200M -q
fi

log "Держать 2 ядра вместо 3"
if (( ! DRY )); then
    if grep -q '^installonly_limit' /etc/dnf/dnf.conf; then
        sed -i 's/^installonly_limit=.*/installonly_limit=2/' /etc/dnf/dnf.conf
    else
        printf 'installonly_limit=2\n' >> /etc/dnf/dnf.conf
    fi
fi

log "Чищу кэш dnf и неиспользуемые flatpak-рантаймы"
run dnf clean packages
run flatpak uninstall --unused -y

log "Готово. Перезагрузись, чтобы всё применилось."
