#!/usr/bin/env bash
# rice-spawn — spawn region как в lilith: выделяешь мышью область на экране,
# выбираешь приложение в rofi — окно открывается floating ровно в этой области.
# Бинд: SUPER+SHIFT+Space (custom/keybinds.lua). Escape на любом шаге — отмена.
set -euo pipefail

pkill -x rofi || true   # закрыть лаунчер, если открыт

# ── 1. Область (slurp), цвета выделения из палитры matugen ──────────────
colors="$HOME/.local/state/quickshell/user/generated/colors.json"
primary="#e7bdb9"
if [[ -r "$colors" ]]; then
    p=$(jq -r '.primary // empty' "$colors")
    [[ "$p" =~ ^#[0-9a-fA-F]{6}$ ]] && primary="$p"
fi
region=$(slurp -f '%x %y %w %h' -w 2 \
    -b "${primary}22" -c "${primary}ff" -s "${primary}33") || exit 0
read -r x y w h <<<"$region"
(( w >= 40 && h >= 40 )) || exit 0   # случайный клик вместо области

# ── 2. Приложение: список .desktop → rofi ───────────────────────────────
# Пользовательский каталог первым: его записи перекрывают системные.
shopt -s nullglob
desktops=( "$HOME"/.local/share/applications/*.desktop /usr/share/applications/*.desktop )
(( ${#desktops[@]} )) || exit 1
mapfile -t entries < <(
    gawk '
        FNR == 1 { name = exec = type = ""; nodisplay = terminal = 0 }
        /^Type=/          { type = substr($0, 6) }
        /^Name=/ && name == "" { name = substr($0, 6) }
        /^Exec=/ && exec == "" { exec = substr($0, 6) }
        /^NoDisplay=true/ { nodisplay = 1 }
        /^Hidden=true/    { nodisplay = 1 }
        /^Terminal=true/  { terminal = 1 }
        ENDFILE {
            if (type == "Application" && !nodisplay && name != "" && exec != "") {
                gsub(/%[fFuUdDnNickvm]/, "", exec)
                gsub(/^[ \t]+|[ \t]+$/, "", exec)
                gsub(/^[ \t]+|[ \t]+$/, "", name)
                if (terminal) exec = "kitty -e " exec
                print name "\t" exec
            }
        }
    ' "${desktops[@]}" | sort -s -u -t $'\t' -k1,1
)
(( ${#entries[@]} )) || exit 1
choice=$(printf '%s\n' "${entries[@]}" | cut -f1 | rofi -dmenu -i -p 'spawn') || exit 0
cmd=""
for e in "${entries[@]}"; do
    if [[ "${e%%$'\t'*}" == "$choice" ]]; then cmd=${e#*$'\t'}; break; fi
done
[[ -n "$cmd" ]] || exit 0

# ── 3. Запуск: floating, точные размер и позиция ────────────────────────
# Inline-правила работают для новых процессов. Если приложение открывает окно
# в уже существующем процессе (chromium, VS Code), правила не применяются —
# тогда находим новое окно и ставим его в область вручную.
lua_cmd=${cmd//\\/\\\\}
lua_cmd=${lua_cmd//\"/\\\"}
before=$(hyprctl clients -j | jq -r '.[].address' | sort)
hyprctl dispatch "hl.dsp.exec_cmd(\"[float; size $w $h; move $x $y] $lua_cmd\")" >/dev/null

for _ in $(seq 1 20); do
    sleep 0.1
    addr=$(comm -13 <(printf '%s\n' "$before") \
        <(hyprctl clients -j | jq -r '.[].address' | sort) | head -1)
    [[ -n "$addr" ]] || continue
    placed=$(hyprctl clients -j | jq \
        --arg a "$addr" --argjson x "$x" --argjson y "$y" \
        --argjson w "$w" --argjson h "$h" \
        '[.[] | select(.address == $a)][0] // {} |
         (.floating == true) and (.at == [$x, $y]) and (.size == [$w, $h])')
    if [[ "$placed" != "true" ]]; then
        hyprctl --batch "dispatch hl.dsp.window.float({action='set', window='address:$addr'}); dispatch hl.dsp.window.resize({x=$w, y=$h, relative=false, window='address:$addr'}); dispatch hl.dsp.window.move({x=$x, y=$y, relative=false, window='address:$addr'})" >/dev/null
    fi
    break
done
