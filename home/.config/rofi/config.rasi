/* rofi — единый центр команд. Tab / Shift+Tab — переключение режимов. */
configuration {
    modes: "drun,run,window,filebrowser,calc:~/.config/rofi/scripts/calc.sh,emoji:~/.config/rofi/scripts/emoji.sh,clip:~/.config/rofi/scripts/clip.sh,power:~/.config/rofi/scripts/power.sh";

    show-icons:     true;
    icon-theme:     "Papirus";
    terminal:       "kitty";

    matching:       "fuzzy";
    sort:           true;
    sorting-method: "fzf";
    case-sensitive: false;

    drun-display-format: "{name}";
    window-format:       "{c}  ·  {t}";

    display-drun:        " apps";
    display-run:         " run";
    display-window:      " windows";
    display-filebrowser: " files";
    display-calc:        " calc";
    display-emoji:       "󰞅 emoji";
    display-clip:        " clip";
    display-power:       "⏻ power";

    /* Tab переключает режимы, а не строки (строки — стрелками) */
    kb-element-next:   "";
    kb-element-prev:   "";
    kb-mode-next:      "Tab,Control+Tab";
    kb-mode-previous:  "ISO_Left_Tab,Control+ISO_Left_Tab";

    filebrowser {
        directories-first: true;
        sorting-method:    "name";
    }
}

@theme "~/.config/rofi/rice.rasi"
