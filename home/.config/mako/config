# mako — запасные уведомления (основные рисует ii).
# Цвета приходят из matugen: ~/.config/mako/colors.conf (шаблон в matugen/templates/mako).

include=~/.config/mako/colors.conf
font=JetBrainsMono Nerd Font 10
border-size=2
border-radius=12
padding=10
margin=8
width=360
height=110
anchor=top-right
default-timeout=5000
max-visible=3

[urgency=critical]
default-timeout=0

# Скрывать всплывающие уведомления от Telegram Desktop
[app-name="Telegram Desktop"]
invisible=1
