// ╭──────────────────────────────────────────────────────────────╮
// Цвета подставляет matugen из палитры обоев (шаблон в ~/.config/matugen/templates/fastfetch)
// ╰──────────────────────────────────────────────────────────────╯
//
// Роли: primary — заголовки секций, secondary/tertiary — акценты,
//   outline — ключи, outline_variant — линии
//
// Иконки — Material Design Icons (U+F0000+): они есть в JetBrainsMono NF
// и попадают в symbol_map из kitty.conf, поэтому рисуются корректно.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // ── Логотип: кастомная картинка (Kitty graphics protocol) ─────────
    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/fastfetch.png",
        "width": 34,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },

    "display": {
        "separator": " ",
        "brightColor": false,
        "key": {
            "type": "both",
            "paddingLeft": 3,
            "width": 12
        },
        "color": {
            "keys": "{{colors.outline.default.hex}}",
            "title": "{{colors.on_surface.default.hex}}",
            "separator": "{{colors.outline_variant.default.hex}}"
        },
        "constants": [
            "────────────────────────────────────────────"
        ]
    },

    "modules": [
        // ── Шапка ──────────────────────────────────────────────────────
        {
            "type": "title",
            "format": "   {##{{colors.tertiary.default.hex_stripped}}}{user-name}{##{{colors.outline.default.hex_stripped}}}@{##{{colors.primary.default.hex_stripped}}}{host-name}{#}"
        },
        {
            "type": "custom",
            "format": "   {##{{colors.outline_variant.default.hex_stripped}}}───────────────────────────────────────────────"
        },

        // ── Система ────────────────────────────────────────────────────
        "break",
        {
            "type": "custom",
            "format": "   {##{{colors.primary.default.hex_stripped}}}󰒓 System {##{{colors.outline_variant.default.hex_stripped}}}{$1}"
        },
        {
            "type": "os",
            "key": "OS",
            "keyIcon": "󰟀",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "host",
            "key": "Host",
            "keyIcon": "󰌢",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyIcon": "󰆧",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyIcon": "󰅐",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyIcon": "󰏓",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyIcon": "󱆃",
            "keyColor": "{{colors.primary.default.hex}}"
        },

        // ── Рабочий стол ───────────────────────────────────────────────
        "break",
        {
            "type": "custom",
            "format": "   {##{{colors.tertiary.default.hex_stripped}}}󰍹 Desktop {##{{colors.outline_variant.default.hex_stripped}}}{$1}"
        },
        {
            "type": "de",
            "key": "DE",
            "keyIcon": "󰪫",
            "keyColor": "{{colors.tertiary.default.hex}}"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyIcon": "󰘔",
            "keyColor": "{{colors.tertiary.default.hex}}"
        },
        {
            "type": "theme",
            "key": "Theme",
            "keyIcon": "󰏘",
            "keyColor": "{{colors.tertiary.default.hex}}"
        },
        {
            "type": "icons",
            "key": "Icons",
            "keyIcon": "󰱨",
            "keyColor": "{{colors.tertiary.default.hex}}"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyIcon": "󰘳",
            "keyColor": "{{colors.tertiary.default.hex}}"
        },

        // ── Железо ─────────────────────────────────────────────────────
        "break",
        {
            "type": "custom",
            "format": "   {##{{colors.secondary.default.hex_stripped}}}󰘚 Hardware {##{{colors.outline_variant.default.hex_stripped}}}{$1}"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyIcon": "󰘚",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyIcon": "󰢮",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyIcon": "󰍛",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        {
            "type": "swap",
            "key": "Swap",
            "keyIcon": "󰓡",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        {
            "type": "disk",
            "key": "Disk",
            "keyIcon": "󰋊",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        {
            "type": "battery",
            "key": "Battery",
            "keyIcon": "󰁹",
            "keyColor": "{{colors.secondary.default.hex}}"
        },

        // ── Палитра ────────────────────────────────────────────────────
        "break",
        {
            "type": "colors",
            "symbol": "block",
            "block": {
                "width": 6
            },
            "paddingLeft": 3
        }
    ]
}
