# ═══════════════════════════════════════════════════════════════════════
#  theme.conf — цвета kitty
#
#  Файл рендерится из ~/rice/theme/palette.toml:
#      python3 ~/rice/theme/render.py
#  Правки здесь затираются при следующем рендере — меняйте палитру.
#
#  Подключается из kitty.conf последней строкой: include theme.conf
# ═══════════════════════════════════════════════════════════════════════

## Основа
foreground           {{ text }}
background           {{ base }}
selection_foreground {{ base }}
selection_background {{ surface2 }}
cursor               {{ mauve }}

## 16 цветов терминала (Catppuccin Mocha)
color0  {{ surface1 }}
color8  {{ surface2 }}
color1  {{ red }}
color9  {{ red }}
color2  {{ green }}
color10 {{ green }}
color3  {{ yellow }}
color11 {{ yellow }}
color4  {{ blue }}
color12 {{ blue }}
color5  {{ mauve }}
color13 {{ mauve }}
color6  {{ teal }}
color14 {{ teal }}
color7  {{ subtext1 }}
color15 {{ subtext0 }}

## Панель вкладок
tab_bar_background      {{ crust }}
active_tab_foreground   {{ base }}
active_tab_background   {{ mauve }}
inactive_tab_foreground {{ subtext0 }}
inactive_tab_background {{ surface0 }}

## Границы сплитов и скроллбар
active_border_color    {{ mauve }}
inactive_border_color  {{ surface0 }}
scrollbar_handle_color {{ surface2 }}
