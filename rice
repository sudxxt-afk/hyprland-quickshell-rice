#!/usr/bin/env bash
#
# rice — связать этот репозиторий с живой системой.
#
#   ./rice link       # симлинки home/* → $HOME (существующие файлы — в бэкап)
#   ./rice snapshot   # скопировать в репо то, что нельзя симлинкать (ii/config.json)
#   ./rice restore    # обратное: ii/config.json → ~/.config/illogical-impulse
#   ./rice status     # что не связано / разошлось
#
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SRC="$REPO/home"
II_LIVE="$HOME/.config/illogical-impulse/config.json"
II_REPO="$REPO/ii/config.json"

log() { printf '\033[1;35m::\033[0m %s\n' "$*"; }

files() { (cd "$SRC" && find . -type f -o -type l | sed 's|^\./||' | sort); }

cmd_link() {
    local backup="$HOME/.local/state/rice-backup/$(date +%Y%m%d-%H%M%S)" n=0
    while read -r rel; do
        local src="$SRC/$rel" dst="$HOME/$rel"
        [[ "$(readlink -f "$dst" 2>/dev/null)" == "$src" ]] && continue
        if [[ -e "$dst" || -L "$dst" ]]; then
            mkdir -p "$backup/$(dirname "$rel")"
            mv "$dst" "$backup/$rel"
        fi
        mkdir -p "$(dirname "$dst")"
        ln -s "$src" "$dst"
        n=$((n + 1))
    done < <(files)
    log "Связано файлов: $n"
    [[ -d "$backup" ]] && log "Старые версии: $backup"
    return 0
}

# ii сохраняет config.json атомарно (через временный файл), и симлинк
# превратился бы в обычный файл — поэтому этот файл копируется, а не линкуется.
cmd_snapshot() {
    cp "$II_LIVE" "$II_REPO"
    log "ii/config.json обновлён из системы"
    git -C "$REPO" status --short
}

cmd_restore() {
    cp "$II_REPO" "$II_LIVE"
    log "~/.config/illogical-impulse/config.json восстановлен из репо"
}

cmd_status() {
    local bad=0
    while read -r rel; do
        if [[ "$(readlink -f "$HOME/$rel" 2>/dev/null)" != "$SRC/$rel" ]]; then
            echo "не связан: ~/$rel"; bad=1
        fi
    done < <(files)
    if ! cmp -s "$II_LIVE" "$II_REPO"; then
        echo "разошёлся: ii/config.json (./rice snapshot)"; bad=1
    fi
    (( bad )) || log "Всё связано и совпадает"
}

case "${1:-}" in
    link)     cmd_link ;;
    snapshot) cmd_snapshot ;;
    restore)  cmd_restore ;;
    status)   cmd_status ;;
    *) sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
