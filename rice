#!/usr/bin/env bash
#
# rice — связать этот репозиторий с живой системой.
#
#   ./rice link       # симлинки home/* → $HOME (существующие файлы — в бэкап)
#   ./rice snapshot   # скопировать в репо то, что нельзя симлинкать (ii/config.json)
#   ./rice restore    # обратное: ii/config.json → ~/.config/illogical-impulse
#   ./rice status     # что не связано / разошлось
#   ./rice doctor     # полная проверка: связи, Hyprland, matugen, зависимости
#   ./rice vscode     # собрать и поставить тему VS Code (цвета пишет matugen)
#   ./rice cava …     # cava-виджет: on | off | auto | status
#   ./rice widget …   # виджеты: glyph|music on | off | status
#
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SRC="$REPO/home"
II_LIVE="$HOME/.config/illogical-impulse/config.json"
II_REPO="$REPO/ii/config.json"

log() { printf '\033[1;35m::\033[0m %s\n' "$*"; }

files() { (cd "$SRC" && find . -type f -o -type l | sed 's|^\./||' | sort); }

cmd_link() {
    local backup="$HOME/.local/state/rice-backup/$(date +%Y%m%d-%H%M%S)" n=0
    while read -r rel; do
        local src="$SRC/$rel" dst="$HOME/$rel"
        [[ "$(readlink -f "$dst" 2>/dev/null)" == "$src" ]] && continue
        if [[ -e "$dst" || -L "$dst" ]]; then
            mkdir -p "$backup/$(dirname "$rel")"
            mv "$dst" "$backup/$rel"
        fi
        mkdir -p "$(dirname "$dst")"
        ln -s "$src" "$dst"
        n=$((n + 1))
    done < <(files)
    log "Связано файлов: $n"
    [[ -d "$backup" ]] && log "Старые версии: $backup"
    return 0
}

# ii сохраняет config.json атомарно (через временный файл), и симлинк
# превратился бы в обычный файл — поэтому этот файл копируется, а не линкуется.
cmd_snapshot() {
    cp "$II_LIVE" "$II_REPO"
    log "ii/config.json обновлён из системы"
    git -C "$REPO" status --short
}

cmd_restore() {
    cp "$II_REPO" "$II_LIVE"
    log "~/.config/illogical-impulse/config.json восстановлен из репо"
}

# ii/config.json нельзя симлинкать (ii перезаписывает файл), поэтому сравниваем
# содержимое, а не байты: switchwall может переформатировать тот же JSON.
ii_same() {
    if command -v jq >/dev/null 2>&1 \
        && jq -e . "$II_LIVE" >/dev/null 2>&1 \
        && jq -e . "$II_REPO" >/dev/null 2>&1; then
        [[ "$(jq -S . "$II_LIVE")" == "$(jq -S . "$II_REPO")" ]]
    else
        cmp -s "$II_LIVE" "$II_REPO"
    fi
}

cmd_status() {
    local bad=0
    while read -r rel; do
        if [[ "$(readlink -f "$HOME/$rel" 2>/dev/null)" != "$SRC/$rel" ]]; then
            echo "не связан: ~/$rel"; bad=1
        fi
    done < <(files)
    if ! ii_same; then
        echo "разошёлся: ii/config.json (./rice snapshot)"; bad=1
    fi
    (( bad )) || log "Всё связано и совпадает"
}

# ── doctor: проверки без изменений системы ─────────────────────────────
cmd_doctor() {
    local fails=0 warns=0 total=0 bad=0
    local green=$'\033[1;32m' yellow=$'\033[1;33m' red=$'\033[1;31m' off=$'\033[0m'
    section() { printf '\n\033[1;35m::\033[0m %s\n' "$*"; }
    ok()   { printf '  %sok%s   %s\n' "$green" "$off" "$*"; }
    warn() { printf '  %swarn%s %s\n' "$yellow" "$off" "$*"; warns=$((warns + 1)); }
    fail() { printf '  %sFAIL%s %s\n' "$red" "$off" "$*"; fails=$((fails + 1)); }

    section "Симлинки"
    while read -r rel; do
        total=$((total + 1))
        if [[ "$(readlink -f "$HOME/$rel" 2>/dev/null)" != "$SRC/$rel" ]]; then
            fail "не связан: ~/$rel"; bad=$((bad + 1))
        fi
    done < <(files)
    (( bad == 0 )) && ok "все $total файлов связаны"

    section "ii"
    if ii_same; then
        ok "ii/config.json совпадает с репо"
    else
        warn "ii/config.json разошёлся — ./rice snapshot"
    fi

    section "Hyprland"
    if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        local errs hv pv plugins
        errs=$(hyprctl configerrors 2>/dev/null || true)
        if [[ -z "${errs//[[:space:]]/}" ]]; then
            ok "hyprctl configerrors пуст"
        else
            fail "hyprctl configerrors: ${errs//$'\n'/ }"
        fi

        plugins=$(hyprctl plugin list 2>/dev/null || true)
        if grep -qi 'hyprexpo' <<<"$plugins"; then
            ok "hyprexpo загружен"
            hv=$(hyprctl version 2>/dev/null | sed -n 's/^Hyprland \([0-9][0-9.]*\).*/\1/p' | head -1)
            pv=$(sed -n 's/^[[:space:]]*Version: v\([0-9][0-9.]*\).*/\1/p' <<<"$plugins" | head -1)
            if [[ -n "$hv" && -n "$pv" && "$hv" != "$pv" ]]; then
                warn "hyprexpo v$pv ≠ Hyprland $hv — пересобрать: hyprexpo-rebuild"
            fi
        else
            warn "hyprexpo не загружен — hyprexpo-rebuild"
        fi
    else
        warn "Hyprland не запущен — проверки конфига пропущены"
    fi

    section "Сгенерированное matugen"
    local f
    for f in \
        "$HOME/.local/state/quickshell/user/generated/colors.json" \
        "$HOME/.config/kitty/theme.conf" \
        "$HOME/.config/rofi/colors.rasi" \
        "$HOME/.config/hypr/hyprlock/colors.conf" \
        "$HOME/.config/fuzzel/fuzzel_theme.ini" \
        "$HOME/.config/btop/themes/matugen.theme" \
        "$HOME/.config/fastfetch/config.jsonc" \
        "$HOME/.config/starship.toml" \
        "$HOME/.config/mako/colors.conf" \
        "$HOME/.vscode/extensions/rice.rice-matugen-1.0.0/themes/matugen-dark.json" \
        "$HOME/.local/share/rice/rice.tdesktop-theme"; do
        if [[ -s "$f" ]]; then ok "${f#"$HOME"/}"; else warn "нет: ${f#"$HOME"/}"; fi
    done

    section "Зависимости"
    local c
    for c in qs matugen rofi cliphist hyprshot cava hypridle kitty qalc wtype playerctl jq notify-send; do
        if command -v "$c" >/dev/null 2>&1; then ok "$c"; else fail "нет: $c"; fi
    done

    section "Итог"
    if (( fails )); then
        printf '  %s%d FAIL%s, %d warn\n' "$red" "$fails" "$off" "$warns"
        return 1
    fi
    printf '  %sвсё ок%s (%d warn)\n' "$green" "$off" "$warns"
}

# ── cava: ручное управление виджетом ───────────────────────────────────
cmd_cava() {
    exec "$REPO/home/.local/bin/rice-cava" "$@"
}

# ── widget: тумблер десктоп-виджетов (правит custom/execs.lua) ──────────
cmd_widget() {
    local name="${1:-}" action="${2:-status}" svc
    case "$name" in
        glyph|chaldea|chaldea-glyph) svc="chaldea-glyph" ;;
        music|player|music-player)   svc="music-player" ;;
        *)
            echo "usage: ./rice widget <glyph|music> <on|off|status>" >&2
            return 1
            ;;
    esac

    local f="$SRC/.config/hypr/custom/execs.lua"
    local line
    line=$(grep -m1 "qs -c ${svc}\"" "$f" || true)
    if [[ -z "$line" ]]; then
        echo "в $f нет строки qs -c $svc" >&2
        return 1
    fi

    local state=on
    [[ "$line" =~ ^[[:space:]]*-- ]] && state=off

    case "$action" in
        status)
            echo "$name: $state"
            return 0
            ;;
        on|off)
            python3 - "$f" "$svc" "$action" <<'PY'
import re, sys
path, svc, action = sys.argv[1:]
src = open(path).read()
pat = re.compile(r'^([ \t]*)(--[ \t]*)?(hl\.exec_cmd\("qs -c ' + re.escape(svc) + r'"\))', re.M)
m = pat.search(src)
if not m:
    sys.exit(f"no line for {svc}")
line = f'{m.group(1)}{"" if action == "on" else "-- "}{m.group(3)}'
open(path, "w").write(src[:m.start()] + line + src[m.end():])
PY
            if [[ "$action" == on ]]; then
                pgrep -f "^qs -c ${svc}$" >/dev/null 2>&1 || setsid -f qs -c "$svc" >/dev/null 2>&1
                log "виджет $name включён (qs -c $svc)"
            else
                pkill -f "^qs -c ${svc}$" >/dev/null 2>&1 || true
                log "виджет $name выключен"
            fi
            ;;
        *)
            echo "usage: ./rice widget <glyph|music> <on|off|status>" >&2
            return 1
            ;;
    esac
}


# VS Code ведёт реестр расширений, поэтому тему ставим штатно из VSIX.
# Файл темы внутри установленного расширения дальше перезаписывает matugen.
VSCODE_EXT="$HOME/.vscode/extensions/rice.rice-matugen-1.0.0"
cmd_vscode() {
    local theme="$HOME/.local/state/rice/vscode-matugen-dark.json"
    if [[ -f "$VSCODE_EXT/themes/matugen-dark.json" ]]; then
        cp "$VSCODE_EXT/themes/matugen-dark.json" "$theme.tmp"
    else
        printf '{ "name": "Rice Matugen", "type": "dark", "colors": {} }\n' > "$theme.tmp"
    fi
    local vsix
    vsix="$(mktemp --suffix=.vsix)"
    python3 - "$REPO/vscode-theme/package.json" "$theme.tmp" "$vsix" <<'PY'
import sys, zipfile
pkg, theme, out = sys.argv[1:]
manifest = """<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Language="en-US" Id="rice-matugen" Version="1.0.0" Publisher="rice"/>
    <DisplayName>Rice Matugen</DisplayName>
    <Description xml:space="preserve">Palette from the wallpaper via matugen</Description>
    <Categories>Themes</Categories>
    <Properties><Property Id="Microsoft.VisualStudio.Code.Engine" Value="^1.70.0"/></Properties>
  </Metadata>
  <Installation><InstallationTarget Id="Microsoft.VisualStudio.Code"/></Installation>
  <Dependencies/>
  <Assets><Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true"/></Assets>
</PackageManifest>
"""
types = """<?xml version="1.0" encoding="utf-8"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
  <Default Extension=".json" ContentType="application/json"/>
  <Default Extension=".vsixmanifest" ContentType="text/xml"/>
</Types>
"""
with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
    z.writestr("extension.vsixmanifest", manifest)
    z.writestr("[Content_Types].xml", types)
    z.write(pkg, "extension/package.json")
    z.write(theme, "extension/themes/matugen-dark.json")
PY
    code --install-extension "$vsix" --force
    rm -f "$vsix" "$theme.tmp"
    log "Тема стоит. Перекрасить: switchwall.sh --noswitch; выбрать: Ctrl+K Ctrl+T → Rice Matugen"
}

case "${1:-}" in
    link)     cmd_link ;;
    snapshot) cmd_snapshot ;;
    restore)  cmd_restore ;;
    status)   cmd_status ;;
    doctor)   cmd_doctor ;;
    vscode)   cmd_vscode ;;
    cava)     shift || true; cmd_cava "$@" ;;
    widget)   shift || true; cmd_widget "$@" ;;
    *) sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
